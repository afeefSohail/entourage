DATABASE_URL=postgresql://entourage:secret@localhost:5432/entourage
REDIS_URL=redis://localhost:6379
S3_BUCKET=entourage-photos
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MIN_IOS_VERSION=2.0.0
PORT=3000
NODE_ENV=development
# Public base for photo URLs (R2 public bucket / custom domain). Leave unset to stream photos through the API.
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev
# Externally reachable API base, used to build photo URLs when S3_PUBLIC_URL is unset.
PUBLIC_API_URL=http://localhost:3001
